.suggestion-card {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(244, 250, 255, 0.96);
  border: 1rpx solid rgba(15, 108, 207, 0.08);
}

.suggestion-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #153d58;
}

.suggestion-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #678097;
}
