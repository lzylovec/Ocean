.hero-status {
  margin-top: 22rpx;
}

.hero-status-detail {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(246, 252, 255, 0.86);
}

.action-list {
  margin-top: 20rpx;
}

.action-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(251, 253, 255, 0.98) 0%, rgba(239, 248, 255, 0.98) 100%);
  border: 1rpx solid rgba(15, 108, 207, 0.08);
}

.action-card + .action-card {
  margin-top: 16rpx;
}

.action-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #133950;
}

.action-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #698097;
}

.site-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.14);
}

.site-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.site-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #143a53;
}

.site-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #698097;
}

.site-risk {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(15, 108, 207, 0.08);
  color: #0f6ccf;
  font-size: 22rpx;
}

.stack-list {
  margin-top: 18rpx;
}

.stack-item {
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(244, 250, 255, 0.96);
  border: 1rpx solid rgba(15, 108, 207, 0.08);
  color: #335675;
  font-size: 24rpx;
}

.stack-item + .stack-item {
  margin-top: 12rpx;
}
