.hero-status {
  margin-top: 22rpx;
}

.job-meta-line {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f7489;
}

.progress-block {
  margin-top: 22rpx;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #234b67;
}

.progress-value {
  font-size: 24rpx;
  color: #0f6ccf;
}

.suggestion-card {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(244, 250, 255, 0.96);
  border: 1rpx solid rgba(15, 108, 207, 0.08);
}

.suggestion-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #153d58;
}

.suggestion-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #678097;
}
