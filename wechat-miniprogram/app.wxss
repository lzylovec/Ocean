page {
  min-height: 100%;
  background:
    radial-gradient(circle at top right, rgba(12, 120, 216, 0.18), transparent 28%),
    linear-gradient(180deg, #f7fcff 0%, #eef8ff 48%, #ecf6fb 100%);
  color: #143a53;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1.2;
}

button::after {
  border: none;
}

.page-shell {
  padding: 28rpx 24rpx 40rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(140deg, #0a69be 0%, #0ea5c6 52%, #49c1d6 100%);
  color: #f6fcff;
  box-shadow: 0 24rpx 60rpx rgba(11, 90, 166, 0.22);
}

.hero-card::before {
  content: "";
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  opacity: 0.84;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 48rpx;
  line-height: 1.16;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(246, 252, 255, 0.9);
}

.panel {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(147, 197, 253, 0.4);
  box-shadow: 0 16rpx 40rpx rgba(26, 61, 98, 0.08);
}

.panel-compact {
  padding: 22rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.section-kicker {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: #4e80a9;
}

.section-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #123a53;
}

.section-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5f7489;
}

.muted-text {
  color: #6f8297;
}

.tiny-text {
  font-size: 22rpx;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  border: 1rpx solid transparent;
}

.status-success {
  background: rgba(22, 150, 120, 0.12);
  color: #107862;
  border-color: rgba(22, 150, 120, 0.18);
}

.status-busy {
  background: rgba(15, 108, 207, 0.12);
  color: #0f6ccf;
  border-color: rgba(15, 108, 207, 0.18);
}

.status-warning {
  background: rgba(245, 158, 11, 0.12);
  color: #b66b00;
  border-color: rgba(245, 158, 11, 0.18);
}

.status-danger {
  background: rgba(225, 29, 72, 0.12);
  color: #be123c;
  border-color: rgba(225, 29, 72, 0.18);
}

.status-neutral {
  background: rgba(100, 116, 139, 0.12);
  color: #526276;
  border-color: rgba(100, 116, 139, 0.18);
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  border: 1rpx solid transparent;
}

.badge-primary {
  background: rgba(15, 108, 207, 0.1);
  color: #0f6ccf;
  border-color: rgba(15, 108, 207, 0.16);
}

.badge-success {
  background: rgba(22, 150, 120, 0.1);
  color: #107862;
  border-color: rgba(22, 150, 120, 0.16);
}

.badge-warning {
  background: rgba(245, 158, 11, 0.12);
  color: #b66b00;
  border-color: rgba(245, 158, 11, 0.18);
}

.badge-danger {
  background: rgba(225, 29, 72, 0.12);
  color: #be123c;
  border-color: rgba(225, 29, 72, 0.18);
}

.badge-neutral {
  background: rgba(100, 116, 139, 0.1);
  color: #526276;
  border-color: rgba(100, 116, 139, 0.16);
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  margin-right: -16rpx;
}

.btn-item {
  width: 50%;
  padding-right: 16rpx;
  margin-bottom: 16rpx;
}

.btn {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, #0b75d9 0%, #1099db 100%);
  color: #f8fbff;
  box-shadow: 0 14rpx 26rpx rgba(15, 108, 207, 0.2);
}

.btn-secondary {
  background: rgba(240, 248, 255, 0.96);
  color: #13507a;
  border: 1rpx solid rgba(15, 108, 207, 0.14);
}

.btn-danger {
  background: rgba(255, 241, 242, 0.96);
  color: #be123c;
  border: 1rpx solid rgba(225, 29, 72, 0.12);
}

.btn-inline {
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #234b67;
}

.field-input,
.field-textarea {
  width: 100%;
  border-radius: 22rpx;
  border: 1rpx solid rgba(15, 108, 207, 0.12);
  background: rgba(248, 252, 255, 0.96);
  color: #143a53;
  font-size: 28rpx;
}

.field-input {
  min-height: 86rpx;
  padding: 0 24rpx;
}

.field-textarea {
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  margin-right: -12rpx;
}

.chip-item {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
  background: rgba(232, 243, 255, 0.92);
  color: #3a6283;
  border: 1rpx solid rgba(15, 108, 207, 0.12);
}

.chip-item-active {
  background: linear-gradient(135deg, #0b75d9 0%, #0ea5c6 100%);
  color: #f8fbff;
  border-color: transparent;
}

.metric-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  margin-right: -16rpx;
}

.metric-item {
  width: 50%;
  padding-right: 16rpx;
  margin-bottom: 16rpx;
}

.metric-card {
  min-height: 168rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 250, 255, 0.96) 100%);
  border: 1rpx solid rgba(15, 108, 207, 0.08);
}

.metric-label {
  font-size: 22rpx;
  color: #5f7489;
}

.metric-value {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #153d58;
  line-height: 1;
}

.metric-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #698097;
}

.list-item {
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(246, 251, 255, 0.96) 100%);
  border: 1rpx solid rgba(15, 108, 207, 0.08);
}

.list-item + .list-item {
  margin-top: 16rpx;
}

.item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #143a53;
  line-height: 1.3;
}

.item-subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #678097;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  margin-right: -12rpx;
}

.meta-tag {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.divider {
  width: 100%;
  height: 1rpx;
  margin: 20rpx 0;
  background: rgba(148, 163, 184, 0.16);
}

.empty-state {
  padding: 36rpx 28rpx;
  border-radius: 24rpx;
  border: 1rpx dashed rgba(15, 108, 207, 0.18);
  background: rgba(255, 255, 255, 0.62);
  text-align: center;
  color: #698097;
  font-size: 24rpx;
  line-height: 1.7;
}

.thumb-row {
  display: flex;
  margin-top: 18rpx;
  margin-right: -16rpx;
}

.thumb-item {
  width: 50%;
  padding-right: 16rpx;
}

.thumb-card {
  width: 100%;
  height: 240rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #d9edf8;
}

.thumb-image {
  width: 100%;
  height: 240rpx;
  border-radius: 24rpx;
  background: #d9edf8;
}

.thumb-placeholder {
  width: 100%;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #6b8197;
  font-size: 22rpx;
  line-height: 1.6;
  padding: 0 24rpx;
  background: linear-gradient(180deg, rgba(219, 237, 248, 0.88) 0%, rgba(231, 243, 252, 0.98) 100%);
}

.note-card {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(243, 248, 253, 0.9);
  color: #49647c;
  font-size: 24rpx;
  line-height: 1.7;
}
